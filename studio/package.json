{
	"name": "waveweaver-studio",
	"private": true,
	"version": "1.0.0",
	"description": "Local audio and video studio",
	"author": "WaveWeaver",
	"license": "AGPL-3.0-only",
	"main": "electron/main.cjs",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node scripts/start.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"demo": "node scripts/make-demo-media.mjs",
		"desktop": "vite build && electron .",
		"dist": "vite build && electron-builder --win && node scripts/link-dev.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.2.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^22.0.0",
		"electron": "^45.2.3",
		"electron-builder": "^26.18.0",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"build": {
		"appId": "com.waveweaver.studio",
		"productName": "WaveWeaver",
		"directories": {
			"output": "dist",
			"buildResources": "electron/assets"
		},
		"files": [
			"electron/*.cjs",
			"package.json"
		],
		"extraResources": [
			{
				"from": "build",
				"to": "studio/build"
			},
			{
				"from": "scripts/start.mjs",
				"to": "studio/scripts/start.mjs"
			},
			{
				"from": "electron/studio-package.json",
				"to": "studio/package.json"
			},
			{
				"from": "../engine",
				"to": "engine/engine",
				"filter": [
					"**/*",
					"!**/__pycache__/**"
				]
			}
		],
		"win": {
			"target": [
				"nsis"
			]
		},
		"nsis": {
			"oneClick": true,
			"perMachine": false,
			"artifactName": "WaveWeaver-Setup-${version}.${ext}"
		}
	}
}
